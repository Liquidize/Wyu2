# Copy to .env and edit. Every value here is optional except WYU2_DOMAIN, and that
# one only matters if you use the tls profile.

# Shown in the plugin before anyone registers.
WYU2_RELAY_NAME=Wyu2 relay
WYU2_RELAY_OPERATOR=you@example.com
WYU2_RELAY_MESSAGE=

# Set to false to run invite only, then hand WYU2_INVITE_CODE to the people you want.
WYU2_REGISTRATION_OPEN=true
WYU2_INVITE_CODE=

# 0 means unlimited.
WYU2_MAX_ACCOUNTS=0
WYU2_MAX_CONTACTS=200
WYU2_REQUESTS_PER_MINUTE=240
WYU2_ACCOUNT_RETENTION_DAYS=90

# Where the relay listens on the host. Keep it on loopback unless something else
# is terminating TLS for you.
WYU2_BIND=127.0.0.1:8080

# Only used by the tls profile. This name must already resolve to this machine,
# and ports 80 and 443 must reach it, or Caddy cannot get a certificate.
WYU2_DOMAIN=relay.example.com
